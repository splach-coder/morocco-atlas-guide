{"HomePage":{"title":"Welcome to Morocco Atlas Guide","description":"Authentic mountain & desert expeditions","heroTag":"Atlas & Sahara Experts","heroTitle":"The Heart of the High Atlas, The Soul of the Sahara","heroFooter":"Bespoke expeditions led by local Berber guides through Morocco's most breathtaking landscapes.","cta":"Explore Adventures","HeroSlider":{"slide1":{"title":"High Atlas","emphasis":"Peaks","subtitle":"Conquer the majestic Mount Toubkal with expert local guides."},"slide2":{"title":"Sahara","emphasis":"Magic","subtitle":"Experience the silence of the dunes and the magic of starlit nights."},"slide3":{"title":"Ancient","emphasis":"Medinas","subtitle":"Uncover the rich history and vibrant culture of Morocco's imperial cities."},"explore":"Explore Journeys","bookWhatsApp":"Book via WhatsApp"},"ReviewsSlider":{"tag":"THE GUEST RECORD","titlePart1":"Voices of the","titlePart2":"High Atlas.","globalIndex":"Global Index","verifiedStories":"Verified Stories","cta":"Document your Discovery"},"PopularDestinations":{"tag":"EXPEDITION CATALOG","titlePart1":"Choose Your","titlePart2":"Frontier.","description":"From the heights of the High Atlas to the deep silence of the Sahara. Every category is a different world.","featured":"Featured","experiences":"Experiences","viewCollection":"View Collection","explore":"Explore","categories":{"toubkal-treks":{"name":"High Atlas Peaks","label":"Toubkal Treks","description":"Conquer North Africa's highest peak and explore authentic Berber villages."},"desert-tours":{"name":"Sahara Sands","label":"Desert Tours","description":"Experience the profound silence of the dunes and the magic of starlit nights."},"imperial-cities":{"name":"Ancient Medinas","label":"Cities","description":"Discover the rich history, vibrant souks, and cultural heart of Morocco."},"excursions":{"name":"Hidden Gems","label":"Excursions","description":"Curated day journeys from Marrakech to the most stunning local landscapes."}}},"WhyTravel":{"tag":"THE MOROCCO ADVANTAGE","titlePart1":"Why Trust the","titlePart2":"Ancestral Guide.","description":"In an age of generic travel, we return to the roots of authentic expedition and Berber hospitality.","reasons":{"01":{"title":"Ancestral Guides","desc":"Born and raised in the High Atlas peaks, our guides offer deep ancestral insights that no script can replicate."},"02":{"title":"Elite Safety","desc":"Our mountain professionals are UIAA certified, specializing in technical safety and high-altitude logistics."},"03":{"title":"Bespoke Pace","desc":"We calibrate every expedition to your unique threshold, curiosity, and physical vision."},"04":{"title":"Boutique Quality","desc":"Defining luxury as authenticity. From remote mountain gites to starlit desert encampments."}}},"AboutPreview":{"tag":"THE ATLAS LEGACY","titlePart1":"More than a","titlePart2":"Journey.","description":"Born and raised in the High Atlas mountains, our team brings a life's worth of local knowledge to every trek. We don't just show you the path; we share our culture, our home, and our heart.","item1Title":"Berber Roots","item1Desc":"Every guide is a native of the peaks you conquer.","item2Title":"Boutique Service","item2Desc":"We believe in small groups and big experiences.","cta":"Discover Our Story","yearsOfHeritage":"Years of Heritage","yearsHeritageDesc":"Our journey began in the dust of Imlil. Today, we are Morocco's leading boutique trekking specialists."},"Gallery":{"title":"Gallery","headlinePart1":"Discover Morocco's Landscapes, ","headlinePart2":"Culture, and Moments in Photos","explore":"Explore Gallery","description":"Step into Morocco through our curated gallery, capturing the beauty, culture, and unforgettable moments from our journeys across the country. From iconic landmarks to hidden gems, experience Morocco in every image."},"FAQ":{"title":"Questions","headlinePart1":"Everything you","headlinePart2":"need to know.","subHeadline":"Professional answers for your mountain and desert preparations.","stillHaveQuestions":"Still Curious?","contactText":"Need more help planning? Our local experts are available 24/7 on WhatsApp.","contactBtn":"Chat with a Guide"},"CTA":{"ready":"Your peak adventure awaits.","text":"Join Morocco Atlas Guide for an unforgettable journey through the heart of the Atlas.","button":"Book Your Expedition"}},"ExpertiseSection":{"tag":"CERTIFIED EXCELLENCE","titleHighAtlas":"High Atlas","heritage":"Heritage.","description":"Led by Lahoucine, a Mountain & Desert Guide recognized by the Ministry of Tourism. Bridging ancestral roots with elite European training (EMMOE Spain, EMHM France).","item1Title":"UIAA Standards","item1Desc":"Union Internationale des Associations d'Alpinisme compliance.","item2Title":"Royal Federation","item2Desc":"Certified by the Royale Marocaine De Ski Et Montagne.","item3Title":"Professional Team","item3Desc":"Expert Guides, Drivers, Muleteers & Cooks.","quote":"\"Our visitors should be happy here.\""},"CoreValuesSection":{"tag":"THE ATLAS PROMISE","titlePart1":"More Than a Tour,","titlePart2":"A Connection.","features":[{"title":"Our People","description":"Meet our exceptional full-time local drivers and guides. They aren't just staff; they are your well-connected friends, sharing lifelong connections and fascinating anecdotes about the region's history and culture. You'll feel like a local in no time."},{"title":"Local Cuisine","description":"Experience flavors that tell a story. Whether it's a cozy family-owned restaurant or a gourmet meal under the Sahara stars, our expertly curated dining experiences offer a glimpse into the heart and soul of Moroccan tradition."},{"title":"Custom Experience","description":"Imagine immersing yourself in the daily life of a nomadic family or cruising through the Sahara on a quad bike. We build custom itineraries tailored to your unique desires, ensuring your journey is nothing short of amazing."},{"title":"Sustainable Travel","description":"Invest in local livelihoods by putting your money where your heart is. Our unique personal touch preserves the cultures you explore, satisfying your curiosity while leaving a positive impact on the communities we visit."}]},"AboutPage":{"banner":{"tag":"BEYOND THE PEAKS","titlePart1":"Berber","titlePart2":"Soul.","description":"Born from the peaks of the High Atlas, dedicated to sharing the authentic magic of Morocco."},"heritage":{"tag":"OUR HERITAGE","titlePart1":"The Legacy of","titlePart2":"Lahoucine","description":"Lahoucine is a Mountain & Desert official Guide recognized by the Moroccan Ministry of Tourism and qualified at the prestigious schools in Europe (EMMOE) Escuela Militar de Montana y Operaciones Especiales in Spain with (Higher Mountain Diploma) and at the (EMHM) Ecole Militaire de Haute Montagne Francaises in France; plus the Federation Royale Marocaine De Ski Et Montagne. Growing up in the heart of the High Atlas Mountains, LAHOUCINE can share his expert local knowledge to take you on an unforgettable adventure. We are a professional and competent team (Guides, Drivers, Muleteers, Cooks,..) led by moroccoatlasguide. You will see beautiful high valleys and snowy peaks, interspersed with charming Berber villages.","quote":{"title":"Safety first","text":"As you travel the world, it's important that you feel safe and comfortable. When you travel with moroccoatlasguide, you can rest assured that your safety is our biggest priority – and having the security of a built-in group of new friends and expert local leader means you can relax and enjoy yourself."}},"mission":{"tag":"OUR MISSION","titlePart1":"Crafting","titlePart2":"Dreams.","text1":"Embark on a thrilling adventure amidst the majestic landscapes of the High Atlas with our comprehensive array of services tailored to meet your every need. Whether you seek a brief guided hike for a day or a complete trekking package, we have you covered. Our offerings include transportation arrangements to the region, cozy accommodations, delicious meals, expert guides, reliable mules for assistance, and beyond.","text2":"Crafting unforgettable experiences, we customize itineraries to align perfectly with your preferences. Tailor-made adventures cater to your interests, time constraints, group size, trek difficulty preferences, and desired accommodation standards. Dive into the heart of the High Atlas and let us turn your expedition dreams into reality."},"whyUs":{"tag":"WHY US?","titlePart1":"The Local","titlePart2":"Difference.","text":"Trekking presents an exceptional opportunity to immerse yourself in Morocco’s stunning natural wonders. Our trekking expeditions offer a glimpse into the diverse and breathtaking landscapes of Morocco, providing firsthand encounters with authentic Berber life across mountains, valleys, countryside, and desert terrain. Morocco Atlas Guide stands as a local, Berber-operated tour company, focusing on trekking adventures and fostering insights into Berber culture. Additionally, we extend our expertise to accommodate all your Moroccan tour requirements, including lodging arrangements, transfers, city tours, and more."},"leaders":{"tag":"LOCAL LEADERS","titlePart1":"The Heart of","titlePart2":"the Journey.","text1":"The best guides to reveal the heart of a destination are the LOCAL LEADERS who live there, which is why we work exclusively with local leaders. On Expeditions, your leader is not just a travel expert but also your teacher, travel guru, and passionate provider of authentic grassroots experiences.","text2":"When people use the word ‘remarkable,’ they’re likely thinking of places like Morocco. In a land where riding camels over dunes at sunset is common, where the air is filled with the aroma of saffron-infused tagines, and where Amazigh herders guide goats along the slopes of the High Atlas Mountains, ‘remarkable’ seems insufficient. Whether you’re strolling through the wind-swept port town of Essaouira, exploring the renowned Kasbah of Aït Benhaddou, or sleeping under the stars in the Sahara, the warm hospitality of the Maghreb will make a tour of Morocco truly unforgettable."},"culture":{"tag":"CULTURAL DIVERSITY","titlePart1":"Crossroads of","titlePart2":"Civilizations.","text1":"Morocco’s rich tapestry of cultures reflects its historical role as a crossroads of civilizations. Over the centuries, the land has been inhabited by diverse peoples, including the indigenous Amazigh (Berbers) alongside influences from the East (Phoenicians and Arabs), the South (Sub-Saharan Africans), and the North (Romans and Spanish Andalusians – both Muslim and Jewish).","text2":"Presently, the majority of Moroccans identify as either Berber or Arab, with Arabic serving as the official language. Islam is the predominant religion, with Sunni Muslims comprising 99% of the population; however, religious minorities are respected and coexist harmoniously.","text3":"Moroccan society prides itself on its hospitality and openness to various cultures, ideas, and lifestyles. Nonetheless, it is crucial to respect local beliefs and cultural norms to avoid inadvertent offense. What may be acceptable in one’s native culture could be misunderstood when navigating the nuances of Moroccan etiquette and customs."},"dressCode":{"tag":"DRESS CODE","titlePart1":"Respect and","titlePart2":"Modesty.","text1":"As previously mentioned, there is a cultural emphasis on modesty, particularly for women, within Muslim communities. The extent to which this influences travelers varies depending on the location within the country, whether it’s a tourist hotspot or not, and the type of accommodation chosen, whether it’s a tourist-oriented hotel or a local establishment.","text2":"It’s advisable to exercise caution in both attire and behavior to avoid inadvertently causing offense. However, Morocco recognizes the value of tourism and extends a warm welcome to visitors, with allowances often made in tourist zones and beaches. In urban centers and resorts along the west coast, Moroccans themselves tend to adopt more Western attitudes."},"thingsToKnow":{"tag":"THINGS TO KNOW","titlePart1":"Before You","titlePart2":"Arrive.","intro":"Morocco is an astounding, eyes-open taste of the exotic. Morocco is also a journey into an eternal, serene world of coastal villages, colorful-painted towns that adhere to hillsides and remote outposts defended by fairy-tale adobe forts.","intro2":"This captivating land is a merging of the African and Arab worlds. It is soaked in age-old traditions. It’s no wonder Morocco has been famous by artists and writers for decades and continues to enchant all that visit.","outro":"However, there are a few things you should know before traveling to Morocco on tourism:","items":["It’s a gorgeous country","Morocco is one of the most peaceful countries in the whole world. It has a lot of places of interest to visit especially when you are boarding on tourism.","Make sure that you exchange Moroccan Dirham to 1 dollar. There is a great currency conversion rate that gives you the opportunity to spend less and enjoy more.","There is a massive travel bargain in the country. Relatively speaking, the rate of the Dirham is decent, and it’s stable. You can least expect any surprises.","The hotels in Morocco are inexpensive, good value, and pretty easy to locate. The land has become a common stop for the visitors that have increased the number of hotels in every region.","Visa and MasterCard are accepted at most ATM for cash advances. However, make sure that credit cards are not accepted at a lot of smaller shops. You can suffice with around 4000 dirhams.","Once you’re in Morocco, you will need cash immediately to pay for transportation. Make sure to get some cash from the first ATM you spot at the airport however, don’t take too much."]},"cta":{"titlePart1":"Begin Your","titlePart2":"Legacy.","enquiry":"Private Enquiry"}},"ContactPage":{"banner":{"tag":"PRIVATE CONCIERGE","titlePart1":"Let's","titlePart2":"Connect.","description":"Reach out directly to our head guide to begin crafting your bespoke Moroccan expedition."},"channels":{"tag":"CHANNELS","titlePart1":"Directly","titlePart2":"to a Guide.","messaging":{"tag":"Instant Messaging","label":"Phone / WhatsApp"},"email":{"tag":"Email Correspondence","label":"Email Address"},"location":{"tag":"Our Base"},"follow":"Follow the Trail"},"form":{"titlePart1":"Send a","titlePart2":"Proclamation.","description":"Tell us about your dream journey.","name":"Your Name","namePlaceholder":"Sarah J.","email":"Email Address","emailPlaceholder":"sarah@example.com","vision":"The Vision","visionPlaceholder":"I would like to trek Mount Toubkal in December...","submit":"Submit via WhatsApp"},"map":{"tag":"OUR LOCATION","titlePart1":"Find Us in","titlePart2":"Imlil."}},"FAQSection":{"tag":"INFORMATION DEPOT","titlePart1":"Common","titlePart2":"Queries.","description":"Technical details for the discerning traveler. Providing clarity before the first step.","items":[{"question":"Is Mount Toubkal suitable for beginners?","answer":"Yes! While it's the highest peak in North Africa, the standard route is non-technical during summer. However, it requires a good level of physical fitness. Our expert guides pace the trek perfectly to help everyone reach the summit safely."},{"question":"What equipment do I need for a High Atlas trek?","answer":"For summer treks, you'll need sturdy hiking boots, layers of comfortable clothing, a sun hat, and a good sleeping bag. Durante el invierno, se requieren crampones y piolets (que podemos proporcionar). Te enviaremos una lista detallada de equipo al hacer la reserva."},{"question":"How do we handle food and water during the tours?","answer":"Our team includes professional cook who prepares fresh, healthy Berber meals (tagines, couscous, fresh salads). We provide safe water during the trek, either purified or bottled, to ensure your health throughout the journey."},{"question":"Can I customize a desert or mountain tour?","answer":"Absolutely! We specialize in tailor-made experiences. Whether you want to extend your stay in a desert camp or add specialized trekking routes in the Atlas, we'll design an itinerary that matches your desires perfectly."},{"question":"How does the WhatsApp booking work?","answer":"It's simple and direct. Once you find a tour you like, click the 'Book via WhatsApp' button. This connects you directly with our lead guide. You can ask questions, confirm dates, and finalize your booking without any complex forms."}]},"CTASection":{"tag":"BEGIN YOUR CHAPTER","titlePart1":"The Mountains","titlePart2":"Are Calling.","description":"Join Morocco Atlas Guide for an unforgettable journey. Whether it's trekking the High Atlas or exploring the Sahara, we provide authentic local experiences tailored just for you.","browseAdventures":"Browse Adventures","speakWithGuide":"Speak with a Guide","marquee":["TOUBKAL SUMMIT","SAHARA MAGIC","AUTHENTIC BERBER","TAILORED LUXURY"]},"GalleryPreview":{"tag":"Real stories from real travelers","titlePart1":"Moments that made every journey","titlePart2":"unforgettable","cta":"See more happiness","moments":{"1":"Truly a once-in-a-lifetime experience!","2":"The guides were exceptionally knowledgeable.","3":"Breathtaking views at every turn.","4":"A perfect blend of culture and adventure.","5":"Sleeping under the stars was unreal.","6":"Flawless organization from start to finish.","7":"The local food we had was amazing.","8":"Felt safe and well taken care of.","9":"Exceeded all our expectations!","10":"The Atlas mountains completely stole our hearts.","11":"Can't wait to come back for another trek.","12":"Memories that will definitely last forever."}},"Header":{"home":"Home","services":"Tours","activities":"Expeditions","about":"Our Heritage","gallery":"Visuals","contact":"Contact","bookNow":"Book Now","tripNow":"Expeditions","bookYourTrip":"Start Journey","allRightsReserved":"All rights reserved."},"Footer":{"vision":"Curating profound desert and mountain experiences since 2012. We believe in the luxury of slow travel and the depth of Berber heritage.","expeditions":"Expeditions","atlasPeaks":"Atlas Peaks","saharaMagic":"Sahara Magic","ancientCities":"Ancient Cities","hiddenGems":"Hidden Gems","company":"Company","ourHeritage":"Our Heritage","gallery":"Gallery","privateEnquiries":"Private Enquiries","getInTouch":"Get in Touch","whatsappAvailable":"WhatsApp Available","privacy":"Privacy","terms":"Terms","craftedBy":"Crafted by"},"Common":{"tagline":"Your Gateway to Toubkal & the Sahara","whatsappBookingMessage":"Hello Morocco Atlas Guide, I would like to book: ","bookNow":"Reserve","viewDetails":"Explore","contactUs":"Inquire","priceFrom":"From","duration":"Duration","perPerson":"pp","whatsappAvailable":"WhatsApp Available"},"ToursPage":{"expeditionCollection":"EXPEDITION COLLECTION","description":"Curated journeys through the most profound landscapes of Morocco, guided by heritage.","allAdventures":"All Adventures","results":"results","discover":"Discover","noJourneys":"No journeys discovered.","categories":{"all":"All","atlas":"Atlas Peaks","sahara":"Sahara Sands","cities":"Ancient Medinas","hidden":"Hidden Gems"}},"GalleryPage":{"banner":{"tag":"EXPEDITION JOURNAL","titlePart1":"Captured","titlePart2":"Moments.","description":"A visual journal of the vibrant colors, breathtaking landscapes, and authentic daily life discovered on our journeys."},"archive":{"tag":"ARCHIVE MMXXIV","titlePart1":"The","titlePart2":"Visual Record.","showing":"Showing {count} of {total} Artifacts","loadMore":"Load More","loading":"Loading","remaining":"{count} remaining","itemTitle":"Atlas Experience","itemCategory":"Highlights"}},"ServiceDetail":{"back":"Back to Adventures","verified":"Verified","experience":{"tag":"THE EXPERIENCE","titlePart1":"Unveil the","titlePart2":"Extraordinary."},"journey":{"tag":"YOUR JOURNEY","titlePart1":"Daily","titlePart2":"Expedition.","daysAdventure":"{count} Days Adventure","day":"Day"},"inclusions":{"tag":"INCLUSIONS","titlePart1":"What's","titlePart2":"Covered."},"exclusions":{"tag":"EXCLUSIONS","titlePart1":"Not","titlePart2":"Included."},"tips":{"tag":"EXPERT TIPS","titlePart1":"Essential","titlePart2":"Advice.","description":"To ensure your journey is as seamless and enjoyable as possible, here are some key insights from our local experts.","tip1":{"title":"Cultural Etiquette","desc":"Morocco is welcoming but conservative. Dress modestly (shoulders/knees covered) when visiting villages or rural areas to show respect."},"tip2":{"title":"Best Time to Go","desc":"Spring (Mar-May) and Autumn (Sep-Nov) offer the best weather. Summers can be hot in the south, while winters see snow in the Atlas."},"tip3":{"title":"Currency & Tips","desc":"Cash is king in remote areas. Carry Moroccan Dirhams (MAD). Tipping (5-10%) is customary and appreciated for good service."}},"gallery":{"titlePart1":"Visual","titlePart2":"Diary."},"booking":{"startingPrice":"Starting Price","perPerson":"/ person","selectDate":"Select Date","guests":"Guests","totalPrice":"Total Price","duration":"Duration","customizable":"Trips are customizable. Contact us to adjust duration, route, or difficulty level.","bookWhatsApp":"Book via WhatsApp","noCommitment":"No commitment required. Chat with an expert first."}}}